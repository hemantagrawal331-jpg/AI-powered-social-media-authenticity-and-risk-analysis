# Backend
APP_NAME=FakeGuard AI
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
DATABASE_URL=sqlite:///./fakeguard.db
MAX_UPLOAD_BYTES=2097152
MAX_IMAGE_BYTES=1048576

# Public profile fetch. Create a key at https://agent.tinyfish.ai/api-keys
# Put the real key in .env only. On Vercel, set TINYFISH_API_KEY in project environment variables.
TINYFISH_API_KEY=
TINYFISH_TIMEOUT_SECONDS=75

# Frontend (copy values into frontend/.env)
VITE_API_URL=http://localhost:8000

# Supabase hosts the dataset Postgres database.
# Put the real values in .env only. Do not prefix them with VITE_.
# The publishable key is not the dataset password and is not used by the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → Database → Connection string → URI (session pooler).
DATASET_DATABASE_URL=
