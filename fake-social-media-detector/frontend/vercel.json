{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install && if [ -d ../backend ]; then rm -rf server && mkdir -p server && cp -R ../backend/app server/app && cp -R ../backend/data server/data; fi",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{server/**,vercel_app.py}"
    },
    "api/[[...path]].py": {
      "maxDuration": 60,
      "includeFiles": "{server/**,vercel_app.py}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
